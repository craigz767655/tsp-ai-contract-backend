# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (Render Postgres connection string) ─────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Auth ────────────────────────────────────────────────
# Generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-secret

# ── AI providers (at least one required for analysis) ────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── CORS: your Lovable frontend origin(s), comma-separated ──
# e.g. https://your-app.lovable.app,https://app.tspaicontract.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
